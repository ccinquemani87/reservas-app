# =================================================== 
# Contrato de variables de entorno - reservas-app 
# =================================================== 

# --- Capa de Base de Datos (reservas-db) --- 
# Nombre de la base de datos a inicializar 
MYSQL_DATABASE=reservasdb 
# Usuario de aplicación sin privilegios administrativos 
MYSQL_USER=reservas_user 
# Contraseña del usuario de aplicación 
MYSQL_PASSWORD=reservas_pass 
# Contraseña administrativa obligatoria para inicializar el motor 
MYSQL_ROOT_PASSWORD=reservas_root_pass 

# --- Capa de API REST (reservas-api) --- 
# Puerto interno donde escucha el servidor Express 
PORT=3000 
# Host del motor de base de datos (nombre del servicio en Compose) 
DB_HOST=reservas-db 
# Puerto TCP de MySQL 
DB_PORT=3306 
# Base de datos y credenciales de acceso 
DB_NAME=reservasdb 
DB_USER=reservas_user 
DB_PASSWORD=reservas_pass 
# Versión de la API y siembra de datos iniciales 
APP_VERSION=v1 
SEED_DEMO=true 

# --- Capa de Frontend y Proxy Inverso (reservas-frontend) --- 
# Destino de proxy\_pass para resolver /api/ 
API_HOST=reservas-api 
API_PORT=3000
